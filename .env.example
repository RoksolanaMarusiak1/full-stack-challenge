# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Postgres (local development: `docker compose up -d db`, then `pnpm db:migrate`)
# In docker-compose the app gets its own DATABASE_URL pointing at the `db` service.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
